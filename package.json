{
	"name": "ink",
	"version": "8.0.0",
	"description": "React for CLI",
	"license": "MIT",
	"repository": "vadimdemedes/ink",
	"author": "Vadim Demedes <vadimdemedes@hey.com> (https://github.com/vadimdemedes)",
	"type": "module",
	"exports": {
		"types": "./build/index.d.ts",
		"default": "./build/index.js"
	},
	"sideEffects": true,
	"engines": {
		"node": ">=22"
	},
	"scripts": {
		"dev": "tsc --watch",
		"build": "tsc",
		"prepare": "npm run build",
		"test": "npm run typecheck && npm run lint && FORCE_COLOR=true node --import=tsx --test --test-concurrency=1 'test/*.{ts,tsx}'",
		"lint": "xo",
		"format": "prettier --write .",
		"typecheck": "tsc --noEmit",
		"example": "NODE_NO_WARNINGS=1 node --import=tsx",
		"benchmark": "NODE_NO_WARNINGS=1 node --import=tsx",
		"inspect": "react-devtools"
	},
	"files": [
		"build"
	],
	"keywords": [
		"react",
		"cli",
		"jsx",
		"stdout",
		"components",
		"command-line",
		"preact",
		"redux",
		"print",
		"render",
		"colors",
		"text"
	],
	"dependencies": {
		"@alcalzone/ansi-tokenize": "^0.3.1",
		"ansi-escapes": "^7.3.0",
		"ansi-styles": "^7.0.0",
		"auto-bind": "^5.0.1",
		"chalk": "^6.0.1",
		"cli-boxes": "^4.0.1",
		"cli-cursor": "^4.0.0",
		"cli-truncate": "^6.0.0",
		"code-excerpt": "^4.0.0",
		"es-toolkit": "^1.52.0",
		"indent-string": "^5.0.0",
		"is-in-ci": "^2.0.0",
		"patch-console": "^2.0.0",
		"quick-lru": "^7.3.0",
		"react-reconciler": "^0.34.0",
		"signal-exit": "^3.0.7",
		"stack-utils": "^2.0.6",
		"string-width": "^8.3.0",
		"terminal-size": "^4.0.1",
		"type-fest": "^5.10.0",
		"widest-line": "^6.0.0",
		"wrap-ansi": "^10.0.2",
		"yoga-layout": "~3.2.1"
	},
	"devDependencies": {
		"@faker-js/faker": "^10.6.0",
		"@sindresorhus/tsconfig": "^8.1.0",
		"@sinonjs/fake-timers": "^15.3.0",
		"@types/ms": "^2.1.0",
		"@types/node": "^26.6.3",
		"@types/react": "^19.3.0",
		"@types/react-reconciler": "^0.33.1",
		"@types/signal-exit": "^3.0.0",
		"@types/sinon": "^22.0.0",
		"@types/stack-utils": "^2.0.3",
		"@types/ws": "^8.18.2",
		"@vdemedes/prettier-config": "^2.0.1",
		"boxen": "^9.0.0",
		"delay": "^7.0.0",
		"eslint-config-xo-react": "^0.32.0",
		"ms": "^2.1.3",
		"node-pty": "^1.2.0-beta.12",
		"p-queue": "^9.3.3",
		"prettier": "^3.9.9",
		"react": "^19.3.0",
		"react-devtools": "^8.0.0",
		"react-devtools-core": "^8.0.0",
		"react-router": "^8.4.0",
		"sinon": "^22.1.0",
		"slice-ansi": "^9.0.1",
		"strip-ansi": "^7.2.0",
		"tsx": "^4.23.15",
		"typescript": "^5.8.3",
		"ws": "^8.22.0",
		"xo": "^5.0.1"
	},
	"peerDependencies": {
		"@types/react": ">=19.3.0",
		"react": ">=19.3.0",
		"react-devtools-core": ">=6.1.2"
	},
	"peerDependenciesMeta": {
		"@types/react": {
			"optional": true
		},
		"react-devtools-core": {
			"optional": true
		}
	},
	"prettier": "@vdemedes/prettier-config"
}
